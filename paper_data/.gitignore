case_level_exports/**
!case_level_exports/
!case_level_exports/.gitkeep

# Generated long-run artifacts. Keep run manifests, split JSONs, and runner
# scripts trackable, but do not commit bulky or machine-local execution output.
final_*/compare_reports/**
final_*/state/**
final_*/run_logs/**
final_*/service_logs/**
final_*/run_summary.tsv
final_*/runner.pid
final_*/runner.log.path
final_*/invalid_bootstrap_run_*/**
final_*/*_accel_*/**

# Local validation and tuning outputs can be tens of GB and include files over
# GitHub's normal single-file limit. Keep durable manifests/splits trackable.
final_dataset_splits_*/smoke_runs/**
workflow_tuning_runs_*/**
workflow_tuning_runs_*_merge_verify/**
