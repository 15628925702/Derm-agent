# Python cache
__pycache__/
*.py[cod]

# Test cache
.pytest_cache/

# Local datasets to exclude from Git
data/

# Generated outputs
outputs/*
!outputs/.gitkeep

# Large evaluation bundles are managed outside the main GitHub repo
final-score/final_runs/
!final-score/final_runs/README.md

# Generated proposals
proposals/composite_skills/

# Local backups
backups/

# Runtime logs
logs/*
!logs/.gitkeep

# Runtime and process state
state/*.pid
state/run_launchers/
state/runtime/
state/experience/
state/policy/
state/policy_skinvl/
state/policy_medgemma/
state/split_states/
state/cognition_state.json
state_medgemma/
state_skinvl/

# LaTeX build artifacts
paper/*.aux
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.xdv
