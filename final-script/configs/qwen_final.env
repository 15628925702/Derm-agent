#!/usr/bin/env bash
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${CONFIG_DIR}/common.env"
source "${CONFIG_DIR}/final_assets_registry.env"

export DERMAGENT_POLICY_ROOT="$QWEN_FINAL_POLICY_ROOT"
export DERMAGENT_SPLIT_STATE_ROOT="$QWEN_FINAL_FROZEN_STATE_ROOT"
export FINAL_AGENT_BASE_URL="$QWEN_SERVER_BASE_URL"
export FINAL_AGENT_API_KEY="$QWEN_SERVER_API_KEY"
export FINAL_AGENT_MODEL="$QWEN_SERVER_MODEL"
export FINAL_BASELINE_BASE_URL="$QWEN_SERVER_BASE_URL"
export FINAL_BASELINE_API_KEY="$QWEN_SERVER_API_KEY"
export FINAL_BASELINE_MODEL="$QWEN_SERVER_MODEL"

export QWEN_FINAL_GPU_MEMORY_UTILIZATION="${QWEN_FINAL_GPU_MEMORY_UTILIZATION:-0.75}"
export QWEN_FINAL_MAX_MODEL_LEN="${QWEN_FINAL_MAX_MODEL_LEN:-6144}"
export QWEN_FINAL_MAX_NUM_SEQS="${QWEN_FINAL_MAX_NUM_SEQS:-1}"
