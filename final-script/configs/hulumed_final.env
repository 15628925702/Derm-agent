#!/usr/bin/env bash

source /root/DermAgent/final-script/configs/common.env
source /root/DermAgent/final-script/configs/model_servers.env

export FINAL_AGENT_BASE_URL="$HULUMED_SERVER_BASE_URL"
export FINAL_AGENT_API_KEY="$HULUMED_SERVER_API_KEY"
export FINAL_AGENT_MODEL="$HULUMED_SERVER_MODEL"
export FINAL_BASELINE_BASE_URL="$HULUMED_SERVER_BASE_URL"
export FINAL_BASELINE_API_KEY="$HULUMED_SERVER_API_KEY"
export FINAL_BASELINE_MODEL="$HULUMED_SERVER_MODEL"

export OPENAI_BASE_URL="$HULUMED_SERVER_BASE_URL"
export OPENAI_API_KEY="$HULUMED_SERVER_API_KEY"
export OPENAI_MODEL="$HULUMED_SERVER_MODEL"
export CLIENT_BASE_URL="$HULUMED_SERVER_BASE_URL"
export CLIENT_API_KEY="$HULUMED_SERVER_API_KEY"
export CLIENT_MODEL="$HULUMED_SERVER_MODEL"

export HULUMED_FINAL_GPU_MEMORY_UTILIZATION="${HULUMED_FINAL_GPU_MEMORY_UTILIZATION:-0.90}"
export HULUMED_FINAL_MAX_MODEL_LEN="${HULUMED_FINAL_MAX_MODEL_LEN:-8192}"
export HULUMED_FINAL_MAX_NUM_SEQS="${HULUMED_FINAL_MAX_NUM_SEQS:-1}"
