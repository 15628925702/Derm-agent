#!/usr/bin/env bash

source /root/DermAgent/final-script/configs/common.env
source /root/DermAgent/final-script/configs/model_servers.env

export FINAL_AGENT_BASE_URL="$LLAMA_SERVER_BASE_URL"
export FINAL_AGENT_API_KEY="$LLAMA_SERVER_API_KEY"
export FINAL_AGENT_MODEL="$LLAMA_SERVER_MODEL"
export FINAL_BASELINE_BASE_URL="$LLAMA_SERVER_BASE_URL"
export FINAL_BASELINE_API_KEY="$LLAMA_SERVER_API_KEY"
export FINAL_BASELINE_MODEL="$LLAMA_SERVER_MODEL"

export OPENAI_BASE_URL="$LLAMA_SERVER_BASE_URL"
export OPENAI_API_KEY="$LLAMA_SERVER_API_KEY"
export OPENAI_MODEL="$LLAMA_SERVER_MODEL"
export CLIENT_BASE_URL="$LLAMA_SERVER_BASE_URL"
export CLIENT_API_KEY="$LLAMA_SERVER_API_KEY"
export CLIENT_MODEL="$LLAMA_SERVER_MODEL"

export LLAMA_FINAL_GPU_MEMORY_UTILIZATION="${LLAMA_FINAL_GPU_MEMORY_UTILIZATION:-0.90}"
export LLAMA_FINAL_MAX_MODEL_LEN="${LLAMA_FINAL_MAX_MODEL_LEN:-8192}"
export LLAMA_FINAL_MAX_NUM_SEQS="${LLAMA_FINAL_MAX_NUM_SEQS:-1}"
