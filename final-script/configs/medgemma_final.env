export FINAL_BASELINE_BASE_URL="$MEDGEMMA_SERVER_BASE_URL"
export FINAL_BASELINE_API_KEY="$MEDGEMMA_SERVER_API_KEY"
export FINAL_BASELINE_MODEL="$MEDGEMMA_SERVER_MODEL"
