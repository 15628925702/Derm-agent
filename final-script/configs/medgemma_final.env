#!/usr/bin/env bash
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${CONFIG_DIR}/common.env"
source "${CONFIG_DIR}/final_assets_registry.env"

export MEDGEMMA_FINAL_GPU_MEMORY_UTILIZATION="${MEDGEMMA_FINAL_GPU_MEMORY_UTILIZATION:-0.85}"

export DERMAGENT_POLICY_ROOT="$MEDGEMMA_FINAL_POLICY_ROOT"
export DERMAGENT_SPLIT_STATE_ROOT="$MEDGEMMA_FINAL_SPLIT_STATE_ROOT"
export FINAL_AGENT_BASE_URL="$MEDGEMMA_SERVER_BASE_URL"
export FINAL_AGENT_API_KEY="$MEDGEMMA_SERVER_API_KEY"
export FINAL_AGENT_MODEL="$MEDGEMMA_SERVER_MODEL"
export FINAL_BASELINE_BASE_URL="$MEDGEMMA_SERVER_BASE_URL"
export FINAL_BASELINE_API_KEY="$MEDGEMMA_SERVER_API_KEY"
export FINAL_BASELINE_MODEL="$MEDGEMMA_SERVER_MODEL"
