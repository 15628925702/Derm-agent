#!/usr/bin/env bash

# OpenAI-compatible local model endpoints for additional model services. These
# variables only describe service connection details; they do not alter
# DermAgent policy, state, or reasoning logic. Existing Qwen/MedGemma/SkinVL
# endpoint variables remain owned by final_assets_registry.env.

export LLAMA_SERVER_BASE_URL="${LLAMA_SERVER_BASE_URL:-http://127.0.0.1:8012/v1}"
export LLAMA_SERVER_API_KEY="${LLAMA_SERVER_API_KEY:-EMPTY}"
export LLAMA_SERVER_MODEL="${LLAMA_SERVER_MODEL:-Llama-3.2-11B-Vision-Instruct}"

export HULUMED_SERVER_BASE_URL="${HULUMED_SERVER_BASE_URL:-http://127.0.0.1:8013/v1}"
export HULUMED_SERVER_API_KEY="${HULUMED_SERVER_API_KEY:-EMPTY}"
export HULUMED_SERVER_MODEL="${HULUMED_SERVER_MODEL:-Hulu-Med-4B}"

export DERMATOLLAMA_SERVER_BASE_URL="${DERMATOLLAMA_SERVER_BASE_URL:-http://127.0.0.1:8014/v1}"
export DERMATOLLAMA_SERVER_API_KEY="${DERMATOLLAMA_SERVER_API_KEY:-EMPTY}"
export DERMATOLLAMA_SERVER_MODEL="${DERMATOLLAMA_SERVER_MODEL:-DermatoLlama-full}"

export DERMAGENT_MODEL_SERVER_TARGETS="qwen medgemma skinvl llama hulumed dermatollama"
