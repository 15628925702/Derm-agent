#!/usr/bin/env bash

source /root/DermAgent/final-script/configs/common.env
source /root/DermAgent/final-script/configs/model_servers.env

export FINAL_AGENT_BASE_URL="$DERMATOLLAMA_SERVER_BASE_URL"
export FINAL_AGENT_API_KEY="$DERMATOLLAMA_SERVER_API_KEY"
export FINAL_AGENT_MODEL="$DERMATOLLAMA_SERVER_MODEL"
export FINAL_BASELINE_BASE_URL="$DERMATOLLAMA_SERVER_BASE_URL"
export FINAL_BASELINE_API_KEY="$DERMATOLLAMA_SERVER_API_KEY"
export FINAL_BASELINE_MODEL="$DERMATOLLAMA_SERVER_MODEL"

export OPENAI_BASE_URL="$DERMATOLLAMA_SERVER_BASE_URL"
export OPENAI_API_KEY="$DERMATOLLAMA_SERVER_API_KEY"
export OPENAI_MODEL="$DERMATOLLAMA_SERVER_MODEL"
export CLIENT_BASE_URL="$DERMATOLLAMA_SERVER_BASE_URL"
export CLIENT_API_KEY="$DERMATOLLAMA_SERVER_API_KEY"
export CLIENT_MODEL="$DERMATOLLAMA_SERVER_MODEL"

export DERMATOLLAMA_FINAL_GPU_MEMORY_UTILIZATION="${DERMATOLLAMA_FINAL_GPU_MEMORY_UTILIZATION:-0.90}"
export DERMATOLLAMA_FINAL_MAX_MODEL_LEN="${DERMATOLLAMA_FINAL_MAX_MODEL_LEN:-8192}"
export DERMATOLLAMA_FINAL_MAX_NUM_SEQS="${DERMATOLLAMA_FINAL_MAX_NUM_SEQS:-1}"
