#!/usr/bin/env bash

DERMAGENT_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DERMAGENT_REPO_ROOT="${DERMAGENT_REPO_ROOT:-$(cd "${DERMAGENT_CONFIG_DIR}/../.." && pwd)}"
export DERMAGENT_DATA_ROOT="${DERMAGENT_DATA_ROOT:-${DERMAGENT_REPO_ROOT}/data}"
export DERMAGENT_FINAL_SCRIPT_ROOT="${DERMAGENT_FINAL_SCRIPT_ROOT:-${DERMAGENT_REPO_ROOT}/final-script}"
export DERMAGENT_FINAL_SCORE_ROOT="${DERMAGENT_FINAL_SCORE_ROOT:-${DERMAGENT_REPO_ROOT}/final-score}"
export DERMAGENT_FINAL_OUTPUT_ROOT="${DERMAGENT_FINAL_OUTPUT_ROOT:-${DERMAGENT_FINAL_SCORE_ROOT}/final_runs}"
export DERMAGENT_FINAL_EXPORT_ROOT="${DERMAGENT_FINAL_EXPORT_ROOT:-${DERMAGENT_FINAL_SCORE_ROOT}/paper_exports}"
export DERMAGENT_EXTERNAL_MANIFEST_ROOT="${DERMAGENT_EXTERNAL_MANIFEST_ROOT:-${DERMAGENT_FINAL_SCRIPT_ROOT}/manifests}"

export DERMAGENT_FINAL_MAIN_QWEN_ROOT="${DERMAGENT_FINAL_MAIN_QWEN_ROOT:-${DERMAGENT_FINAL_OUTPUT_ROOT}/main_qwen_vs_agent_qwen}"
export DERMAGENT_FINAL_MAIN_MEDGEMMA_ROOT="${DERMAGENT_FINAL_MAIN_MEDGEMMA_ROOT:-${DERMAGENT_FINAL_OUTPUT_ROOT}/main_medgemma_vs_agent_medgemma}"
export DERMAGENT_FINAL_MAIN_SKINVL_ROOT="${DERMAGENT_FINAL_MAIN_SKINVL_ROOT:-${DERMAGENT_FINAL_OUTPUT_ROOT}/main_skinvl_vs_agent_skinvl}"
export DERMAGENT_FINAL_ABLATIONS_QWEN_ROOT="${DERMAGENT_FINAL_ABLATIONS_QWEN_ROOT:-${DERMAGENT_FINAL_OUTPUT_ROOT}/ablations_qwen}"
export DERMAGENT_FINAL_EXTERNAL_QWEN_ROOT="${DERMAGENT_FINAL_EXTERNAL_QWEN_ROOT:-${DERMAGENT_FINAL_OUTPUT_ROOT}/external_qwen}"
export DERMAGENT_FINAL_PAIRED_STATS_ROOT="${DERMAGENT_FINAL_PAIRED_STATS_ROOT:-${DERMAGENT_FINAL_OUTPUT_ROOT}/paired_stats}"
export DERMAGENT_FINAL_QUAL_CASE_ROOT="${DERMAGENT_FINAL_QUAL_CASE_ROOT:-${DERMAGENT_FINAL_OUTPUT_ROOT}/qual_case_study}"
export DERMAGENT_FINAL_TABLES_ROOT="${DERMAGENT_FINAL_TABLES_ROOT:-${DERMAGENT_FINAL_EXPORT_ROOT}/tables}"
export DERMAGENT_FINAL_FIGURES_ROOT="${DERMAGENT_FINAL_FIGURES_ROOT:-${DERMAGENT_FINAL_EXPORT_ROOT}/figures}"

export DERMAGENT_DEFAULT_TEST_SPLIT_JSON="${DERMAGENT_DEFAULT_TEST_SPLIT_JSON:-${DERMAGENT_REPO_ROOT}/outputs/pad_ufes_20_split.json}"
export DERMAGENT_DEFAULT_DATA_SPLIT="test"
export DERMAGENT_DEFAULT_PHASE="full"

mkdir -p \
  "$DERMAGENT_FINAL_SCORE_ROOT" \
  "$DERMAGENT_FINAL_OUTPUT_ROOT" \
  "$DERMAGENT_FINAL_EXPORT_ROOT" \
  "$DERMAGENT_FINAL_MAIN_QWEN_ROOT" \
  "$DERMAGENT_FINAL_MAIN_MEDGEMMA_ROOT" \
  "$DERMAGENT_FINAL_MAIN_SKINVL_ROOT" \
  "$DERMAGENT_FINAL_ABLATIONS_QWEN_ROOT" \
  "$DERMAGENT_FINAL_EXTERNAL_QWEN_ROOT" \
  "$DERMAGENT_FINAL_PAIRED_STATS_ROOT" \
  "$DERMAGENT_FINAL_QUAL_CASE_ROOT" \
  "$DERMAGENT_FINAL_TABLES_ROOT" \
  "$DERMAGENT_FINAL_FIGURES_ROOT"
