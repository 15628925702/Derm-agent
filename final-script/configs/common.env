  "$DERMAGENT_FINAL_SCORE_ROOT" \
  "$DERMAGENT_FINAL_OUTPUT_ROOT" \
  "$DERMAGENT_FINAL_EXPORT_ROOT" \
  "$DERMAGENT_FINAL_MAIN_QWEN_ROOT" \
  "$DERMAGENT_FINAL_MAIN_MEDGEMMA_ROOT" \
  "$DERMAGENT_FINAL_MAIN_SKINVL_ROOT" \
  "$DERMAGENT_FINAL_ABLATIONS_QWEN_ROOT" \
  "$DERMAGENT_FINAL_EXTERNAL_QWEN_ROOT" \
  "$DERMAGENT_FINAL_PAIRED_STATS_ROOT" \
  "$DERMAGENT_FINAL_QUAL_CASE_ROOT" \
  "$DERMAGENT_FINAL_TABLES_ROOT" \
  "$DERMAGENT_FINAL_FIGURES_ROOT"
