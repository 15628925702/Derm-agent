export DERMAGENT_FINAL_PAIRED_STATS_ROOT="/root/DermAgent/final-score/final_runs/paired_stats"
export DERMAGENT_FINAL_QUAL_CASE_ROOT="/root/DermAgent/final-score/final_runs/qual_case_study"
export DERMAGENT_FINAL_TABLES_ROOT="/root/DermAgent/final-score/paper_exports/tables"
export DERMAGENT_FINAL_FIGURES_ROOT="/root/DermAgent/final-score/paper_exports/figures"

export DERMAGENT_DEFAULT_TEST_SPLIT_JSON="/root/DermAgent/outputs/pad_ufes_20_split.json"
export DERMAGENT_DEFAULT_DATA_SPLIT="test"
export DERMAGENT_DEFAULT_PHASE="full"

