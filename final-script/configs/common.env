export DERMAGENT_FINAL_SCORE_ROOT="/root/DermAgent/final-score"
export DERMAGENT_FINAL_OUTPUT_ROOT="/root/DermAgent/final-score/final_runs"
export DERMAGENT_FINAL_EXPORT_ROOT="/root/DermAgent/final-score/paper_exports"
export DERMAGENT_EXTERNAL_MANIFEST_ROOT="/root/DermAgent/final-script/manifests"

export DERMAGENT_FINAL_MAIN_QWEN_ROOT="/root/DermAgent/final-score/final_runs/main_qwen_vs_agent_qwen"
export DERMAGENT_FINAL_MAIN_MEDGEMMA_ROOT="/root/DermAgent/final-score/final_runs/main_medgemma_vs_agent_medgemma"
export DERMAGENT_FINAL_MAIN_SKINVL_ROOT="/root/DermAgent/final-score/final_runs/main_skinvl_vs_agent_skinvl"
export DERMAGENT_FINAL_ABLATIONS_QWEN_ROOT="/root/DermAgent/final-score/final_runs/ablations_qwen"
